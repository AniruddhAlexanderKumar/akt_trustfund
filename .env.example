# Public canonical origin, used for SEO metadata, robots.txt and sitemap.xml.
# Set this to the live domain once the site is published.
NEXT_PUBLIC_SITE_URL=

# Contact enquiry delivery (optional).
# Until all three values are present, the enquiry form shows an honest
# "not yet accepting submissions" notice and POST /api/contact returns 503.
CONTACT_TO_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
